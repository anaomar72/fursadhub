# Copy this file to .env for local development.
# Never commit a real .env file or real secrets (see SECURITY.md).

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fursadhub
DB_USERNAME=fursadhub
DB_PASSWORD=fursadhub

# ---------------------------------------------------------------------------
# JWT (Phase 1 — access-token signing). Generate local-only RS256 key pairs,
# never reuse the same key pair across local/staging/production. If left
# blank, the API generates an ephemeral in-memory keypair at startup — this
# is only acceptable for local development and tests, never staging/production.
# ---------------------------------------------------------------------------
JWT_ISSUER=fursadhub
JWT_AUDIENCE=fursadhub-api
JWT_ACCESS_TOKEN_TTL=10m
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Auth (Phase 1 — refresh/verification/reset token lifetimes and cookie policy)
# ---------------------------------------------------------------------------
REFRESH_TOKEN_TTL=30d
# Email verification now uses a 4-digit code (not a link) — see CLAUDE.md section 13.
EMAIL_VERIFICATION_TOKEN_TTL=10m
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s
# HMAC key used to hash the 4-digit code at rest. If left blank, the API generates an ephemeral
# in-memory secret at startup — this is only acceptable for local development and tests, never
# staging/production.
EMAIL_VERIFICATION_CODE_SECRET=
PASSWORD_RESET_TOKEN_TTL=1h
COOKIE_SECURE=false
COOKIE_DOMAIN=
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# S3-compatible private object storage (local: MinIO via infra/compose.yaml)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fursadhub-local
STORAGE_ACCESS_KEY=fursadhub
STORAGE_SECRET_KEY=fursadhub-local-secret

# ---------------------------------------------------------------------------
# SMTP / transactional email (local: MailDev via infra/compose.yaml)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@fursadhub.local

# ---------------------------------------------------------------------------
# Backend / CORS
# ---------------------------------------------------------------------------
SERVER_PORT=8080
FURSADHUB_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
