# Copy this file to .env for local development.
# Never commit a real .env file or real secrets (see SECURITY.md).

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fursadhub
DB_USERNAME=fursadhub
DB_PASSWORD=postgres

# ---------------------------------------------------------------------------
# JWT (Phase 1 — access-token signing). Generate local-only RS256 key pairs,
# never reuse the same key pair across local/staging/production. If left
# blank, the API generates an ephemeral in-memory keypair at startup — this
# is only acceptable for local development and tests, never staging/production.
# ---------------------------------------------------------------------------
JWT_ISSUER=fursadhub
JWT_AUDIENCE=fursadhub-api
JWT_ACCESS_TOKEN_TTL=10m
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Auth (Phase 1 — refresh/verification/reset token lifetimes and cookie policy)
# ---------------------------------------------------------------------------
REFRESH_TOKEN_TTL=30d
# Email verification now uses a 4-digit code (not a link) — see CLAUDE.md section 13.
EMAIL_VERIFICATION_TOKEN_TTL=10m
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s
# HMAC key used to hash the 4-digit code at rest. If left blank, the API generates an ephemeral
# in-memory secret at startup — this is only acceptable for local development and tests, never
# staging/production.
EMAIL_VERIFICATION_CODE_SECRET=
PASSWORD_RESET_TOKEN_TTL=1h
COOKIE_SECURE=false
COOKIE_DOMAIN=
APP_BASE_URL=http://localhost:5173
# Login rate limiting (CLAUDE.md section 18/21) — per-email and per-IP attempt caps in a rolling window.
LOGIN_MAX_ATTEMPTS_PER_EMAIL=10
LOGIN_MAX_ATTEMPTS_PER_IP=30

# ---------------------------------------------------------------------------
# Platform administration (Phase 7)
# ---------------------------------------------------------------------------
# The first SUPER_ADMIN. Platform roles can only be granted by an existing
# SUPER_ADMIN, so without this nobody could ever become one and the admin
# console would be unreachable (CLAUDE.md section 23).
#
# Usage: register the account through the normal sign-up flow FIRST, then set
# this to that address and restart. Startup does nothing unless the account
# already exists, and nothing at all once any active platform grant exists —
# so it cannot later be used to restore authority to a revoked account.
#
# Leave blank in production once the first admin is in place.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# S3-compatible private object storage (local: MinIO via infra/compose.yaml).
# Phase 6 stores the student's final internship report here; Phase 7 adds the
# student's CV and university verification evidence — never in PostgreSQL, and
# never behind a public URL (CLAUDE.md section 47, ADR-004).
#
# STORAGE_PROVIDER=s3 is the default and the only value permitted in staging
# or production; the API refuses to start otherwise. `filesystem` writes to a
# local directory and exists purely so local development and the integration
# suite can run without a MinIO container.
#
# The bucket named below must exist and must be PRIVATE — no public-read
# policy and no static website hosting.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fursadhub-local
STORAGE_ACCESS_KEY=fursadhub
STORAGE_SECRET_KEY=fursadhub-local-secret
# Only used when STORAGE_PROVIDER=filesystem — a local directory to write documents to instead of
# MinIO. Leave blank to fall back to the OS temp directory. Never set this in staging/production;
# StorageConfig refuses to start with provider=filesystem outside local/CI.
STORAGE_FILESYSTEM_DIRECTORY=

# ---------------------------------------------------------------------------
# SMTP / transactional email (local: MailDev via infra/compose.yaml)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@fursadhub.local

# ---------------------------------------------------------------------------
# Backend / CORS
# ---------------------------------------------------------------------------
SERVER_PORT=8080
FURSADHUB_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
