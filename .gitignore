# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# Backend (Maven / Java)
apps/api/target/
apps/api/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!apps/api/.mvn/wrapper/maven-wrapper.properties
hs_err_pid*

# Frontend (Node)
node_modules/
apps/web/dist/
apps/web/dist-ssr/
apps/web/coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# E2E (Playwright)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/

# E2E credentials and session state. The authenticated suites are pointed at a provisioned QA
# environment through FH_QA_MANIFEST, and that manifest holds real passwords — it belongs outside
# the repository entirely. These patterns are a backstop against a storageState or manifest ever
# being written into the tree by accident.
e2e/**/*.auth.json
e2e/**/storage-state*.json
e2e/**/qa-manifest*.json
**/.qa-credentials*

# Logs
logs/
*.log

# Local infra volumes
infra/.data/

# Astra local QA evidence and development-only previews (retained locally, not shipped)
/apps/web/phase1.html
/apps/web/phase2.html
/apps/web/src/dev/Phase1Preview.tsx
/apps/web/src/dev/Phase2Preview.tsx
/apps/web/vite.astra-preview.config.ts
/e2e/playwright.astra.config.ts
/docs/audits/astra-baseline/
/docs/audits/astra-phase1/
/docs/audits/astra-phase2/
/docs/audits/astra-phase1-build.txt
/docs/audits/astra-phase1-lint.txt
/docs/audits/astra-phase1-unit-results.json
