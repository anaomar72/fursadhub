<?xml version="1.0" encoding="UTF-8"?>
<!--
  Safe logging foundation: every line carries timestamp, level, thread, logger, and the
  request correlation id (see CorrelationIdFilter) without ever printing request/response
  bodies, headers, or secrets. Feature code must never log passwords, tokens, or Authorization
  headers (see CLAUDE.md section 68).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId:-no-request-id}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
